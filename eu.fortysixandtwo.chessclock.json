{
    "app-id": "eu.fortysixandtwo.chessclock",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "chess-clock",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/gtk-doc",
        "/share/vala",
        "*.la"
    ],
    "modules": [
        {
            "name": "gsound",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/gsound.git",
                    "tag": "1.0.3",
                    "commit": "95d36d60cf53e0e7c5d5325e0f1f4fc765a611ae"
                }
            ],
            "modules": [
                {
                    "name": "libcanberra",
                    "config-opts": [
                        "--disable-alsa",
                        "--disable-null",
                        "--disable-oss"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "http://0pointer.de/lennart/projects/libcanberra/libcanberra-0.30.tar.xz",
                            "sha256": "c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72"
                        }
                    ]
                }
            ]
        },
        {
            "name": "chess-clock",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/World/chess-clock.git",
                    "tag": "v0.6.3-currently-unsigned",
                    "commit": "7a05add5270e46c6847fab6934be4a46f2062480"
                }
            ]
        }
    ]
}
